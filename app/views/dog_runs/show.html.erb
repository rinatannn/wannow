<div class="dog-run-show">
  <section class="dog-run-info-card">
    <h1><%= @dog_run.name %></h1>

<p>住所：<%= @dog_run.address %></p>
<h2>📍 ドッグランの場所</h2>

<div id="dog-run-map"
     data-latitude="<%= @dog_run.latitude %>"
     data-longitude="<%= @dog_run.longitude %>"
     style="width: 100%; height: 350px;">
</div>

<p>
  営業時間：
  <%= @dog_run.opening_time.strftime("%H:%M") %>〜
  <%= @dog_run.closing_time.strftime("%H:%M") %>
</p>

<p>室内：<%= @dog_run.indoor? ? "あり" : "なし" %></p>

  </section>
</div>

<section class="dog-run-status-card">
  <h2>🐶 現在の利用状況</h2>

  <p class="dog-run-status-label">現在の利用頭数</p>

  <p class="dog-run-status-count">
    <%= @dog_run.check_ins.where(checked_out_at: nil).count %>
    <span>頭</span>
  </p>
</section>

<hr>

<section class="dog-run-checkin-card">
  <h2>🐾 チェックイン</h2>

<% if authenticated? %>
  <% dogs = Current.user.dogs %>

  <% available_dogs = dogs.where.not(
  id: CheckIn.where(checked_out_at: nil).select(:dog_id)
) %>

 <% active_check_ins = @dog_run.check_ins
                              .where(dog_id: dogs.select(:id), checked_out_at: nil)
                              .includes(:dog) %>

<% active_check_ins.each do |check_in| %>
  <p><%= check_in.dog.name %></p>

  <%= button_to "チェックアウトする",
                check_in_path(check_in),
                method: :delete %>
<% end %>

  <% if available_dogs.any? %>
    <%= form_with url: check_ins_path, method: :post do |f| %>
      <%= hidden_field_tag :dog_run_id, @dog_run.id %>

      <p>
        <%= f.label :dog_id, "チェックインする犬" %>
        <%= select_tag :dog_id, options_from_collection_for_select(available_dogs, :id, :name) %>
      </p>

      <%= f.submit "チェックインする" %>
    <% end %>
  <% elsif dogs.empty? %>
  <p>チェックインするには犬の登録が必要です。</p>
<% end %>
<% else %>
  <p>チェックインするにはログインが必要です。</p>
<% end %>
</section>

<hr>

<section class="dog-run-reservation-card">
  <h2>📅 来場予定を登録する</h2>

<% if authenticated? %>
  <% if Current.user.dogs.any? %>
    <%= form_with url: visit_plans_path, method: :post do |f| %>
      <%= hidden_field_tag :dog_run_id, @dog_run.id %>

      <p>
        <%= label_tag :dog_id, "来場予定の犬" %>
        <%= select_tag :dog_id,
              options_from_collection_for_select(Current.user.dogs, :id, :name) %>
      </p>

      <p>
        <%= label_tag :planned_at, "来場予定日時" %>
        <%= datetime_local_field_tag :planned_at, nil, required: true %>
      </p>

      <%= f.submit "来場予定を登録する" %>
    <% end %>
  <% else %>
    <p>来場予定を登録するには、犬の登録が必要です。</p>
  <% end %>
<% else %>
  <p>来場予定を登録するにはログインが必要です。</p>
<% end %>
</section>

<hr>

<section class="dog-run-plans-card">
  <h2>📅 このドッグランの来場予定</h2>

<% visit_plans = @dog_run.visit_plans
                          .includes(:dog)
                          .where("planned_at >= ?", Time.current)
                          .order(:planned_at) %>

<% if visit_plans.any? %>
  <% visit_plans.each do |visit_plan| %>
    <p>
      <%= visit_plan.dog.name %>：
      <%= visit_plan.planned_at.strftime("%Y年%m月%d日") %>（<%= %w(日 月 火 水 木 金 土)[visit_plan.planned_at.wday] %>）<%= visit_plan.planned_at.strftime("%H:%M") %>
    </p>

    <% if authenticated? && visit_plan.dog.user_id == Current.user.id %>
      <%= button_to "予定をキャンセルする",
                    visit_plan_path(visit_plan),
                    method: :delete %>
    <% end %>
  <% end %>
<% else %>
  <p>現在、来場予定はありません。</p>
<% end %>
</section>

<div class="dog-run-back-area">
  <%= link_to "← ドッグラン一覧に戻る",
              dog_runs_path,
              class: "dog-run-back-link" %>
</div>

<% if @dog_run.latitude.present? && @dog_run.longitude.present? %>
  <script>
    window.initDogRunMap = function() {
      const mapElement = document.getElementById("dog-run-map");
      if (!mapElement) return;

      const position = {
        lat: Number(mapElement.dataset.latitude),
        lng: Number(mapElement.dataset.longitude)
      };

      const map = new google.maps.Map(mapElement, {
        center: position,
        zoom: 15
      });

      new google.maps.Marker({
        position: position,
        map: map
      });
    };
  </script>

  <script
    src="https://maps.googleapis.com/maps/api/js?key=<%= ERB::Util.url_encode(ENV.fetch('GOOGLE_MAPS_API_KEY')) %>&callback=initDogRunMap"
    async
    defer>
  </script>
<% end %>