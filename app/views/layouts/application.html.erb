
<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Wannow" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Bootstrap 5.3のCSSを読み込む %>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

<%# WanNow独自のCSSを読み込む %>
<%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%# 全ページ共通のヘッダー %>
    <header>
      <nav>
        <%# アプリ名をクリックするとトップページへ移動 %>
        <%= link_to "WAN NOW", root_path %>

        <div class="nav-links">
          <%= link_to "Top", root_path %>
          <%= link_to "About", about_path %>
          <%= link_to "ドッグラン一覧", dog_runs_path %>
          <%= link_to "投稿一覧", posts_path %>
          <%= link_to "グループ一覧", groups_path %>
          <%= link_to "カレンダー", visit_plans_path %>

          <%# ログイン状態によって表示するリンクを切り替える %>
          <% if authenticated? %>
            <%= link_to "♡ いいねした投稿", liked_posts_path %>
            <%= link_to "愛犬登録", new_dog_path %>
            <%= link_to "マイページ", mypage_path %>

            <%# ログアウト %>
            <%= button_to "Sign out", session_path, method: :delete %>
          <% else %>
            <%= link_to "新規登録", new_user_path %>
            <%= link_to "Sign in", new_session_path %>
          <% end %>
        </div>
      </nav>
    </header>

        <% if authenticated? %>
      <div class="header-search">
        <%= form_with url: users_path, method: :get, local: true do |f| %>
          <%= f.text_field :keyword, placeholder: "ユーザー名を検索" %>
          <%= f.submit "ユーザー検索" %>
        <% end %>

        <%= form_with url: posts_path, method: :get, local: true do |f| %>
          <%= f.text_field :keyword, placeholder: "投稿を検索" %>
          <%= f.submit "投稿検索" %>
        <% end %>
      </div>
    <% end %>

    <%# 各ページ固有の内容を表示 %>
    <main>
  <% if flash[:notice].present? %>
    <div class="flash-message flash-notice" role="status">
      <%= flash[:notice] %>
    </div>
  <% end %>

  <% if flash[:alert].present? %>
    <div class="flash-message flash-alert" role="alert">
      <%= flash[:alert] %>
    </div>
  <% end %>

  <%= yield %>
</main>
  </body>
</html>
