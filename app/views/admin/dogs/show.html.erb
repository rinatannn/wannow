
<div class="container my-5">
  <h2 class="fw-bold mb-4">愛犬詳細</h2>

  <div class="card shadow-sm border-0">
    <div class="card-body p-4">

      <div class="row g-4 align-items-center">
        <!-- 左側：愛犬の写真 -->
        <div class="col-md-4 text-center">
          <% if @dog.photo.attached? %>
            <%= image_tag @dog.photo,
                class: "img-fluid rounded shadow-sm",
                style: "max-height: 320px; object-fit: cover;",
                alt: @dog.name %>
          <% else %>
            <div class="bg-light rounded p-5 text-muted">
              写真は登録されていません
            </div>
          <% end %>
        </div>

        <!-- 右側：愛犬のプロフィール -->
        <div class="col-md-8">
          <div class="mb-3">
            <span class="badge text-bg-secondary">
              ID：<%= @dog.id %>
            </span>
          </div>

          <h3 class="fw-bold mb-4"><%= @dog.name %></h3>

          <div class="mb-3">
            <strong class="text-secondary">犬種</strong>
            <p class="fs-5 mb-0"><%= @dog.breed %></p>
          </div>

          <hr>

          <div>
            <strong class="text-secondary">性格</strong>
            <p class="mb-0" style="white-space: pre-wrap;"><%= @dog.personality %></p>
          </div>
        </div>
      </div>

      <!-- 飼い主情報 -->
      <hr class="my-4">

      <h4 class="fw-bold mb-3">飼い主情報</h4>

      <div class="bg-light rounded p-3">
        <p class="mb-3">
          <strong>飼い主名：</strong>
          <%= @dog.user.name %>
        </p>

        <%= link_to "飼い主の詳細を見る",
            admin_user_path(@dog.user),
            class: "btn btn-outline-primary btn-sm" %>
      </div>

    </div>
  </div>

  <!-- 一覧に戻る -->
  <div class="mt-4">
    <%= link_to "愛犬一覧に戻る",
        admin_dogs_path,
        class: "btn btn-outline-secondary" %>
  </div>
</div>
