<div class="container mt-4">
  <h2>愛犬管理一覧</h2>

  <% if @dogs.any? %>
    <table class="table table-bordered table-striped mt-3">
      <thead>
        <tr>
          <th>ID</th>
          <th>愛犬名</th>
          <th>犬種</th>
          <th>飼い主</th>
          <th>詳細</th>
        </tr>
      </thead>

      <tbody>
        <% @dogs.each do |dog| %>
          <tr>
            <td><%= dog.id %></td>
            <td><%= dog.name %></td>
            <td><%= dog.breed %></td>
            <td><%= dog.user.name %></td>
            <td>
              <%= link_to "詳細を見る", admin_dog_path(dog), class: "btn btn-primary btn-sm" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="mt-3">登録されている愛犬はいません。</p>
  <% end %>
</div>