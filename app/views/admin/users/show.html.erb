<h1>ユーザー詳細（管理者）</h1>

<table class="table table-bordered">
  <tbody>
    <tr>
      <th>ユーザーID</th>
      <td><%= @user.id %></td>
    </tr>
    <tr>
      <th>名前</th>
      <td><%= @user.name %></td>
    </tr>
    <tr>
      <th>メールアドレス</th>
      <td><%= @user.email_address %></td>
    </tr>
    <tr>
      <th>登録日時</th>
      <td><%= @user.created_at.strftime("%Y/%m/%d %H:%M") %></td>
    </tr>
    <tr>
      <th>利用状況</th>
      <td>
        <% if @user.is_active? %>
          利用中
        <% else %>
          利用停止
        <% end %>
      </td>
    </tr>
  </tbody>
</table>

<%= link_to "ユーザー一覧に戻る", admin_users_path %>

<% unless @user.admin? || @user.guest? %>
  <% if @user.is_active? %>
    <%= button_to "このユーザーを利用停止にする",
                  suspend_admin_user_path(@user),
                  method: :patch,
                  data: { turbo_confirm: "本当にこのユーザーを利用停止にしますか？" },
                  class: "btn btn-danger" %>
  <% else %>
    <%= button_to "このユーザーの利用を再開する",
                  reactivate_admin_user_path(@user),
                  method: :patch,
                  data: { turbo_confirm: "このユーザーの利用を再開しますか？" },
                  class: "btn btn-success" %>
  <% end %>
<% end %>