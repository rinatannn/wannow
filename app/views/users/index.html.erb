<h1>ユーザー検索</h1>

<%= form_with url: users_path, method: :get, local: true do |f| %>
  <%= f.text_field :keyword, value: params[:keyword], placeholder: "ユーザー名を入力" %>
  <%= f.submit "検索" %>
<% end %>

<hr>

<% if @users.any? %>
  <% @users.each do |user| %>
    <div>
      <p><%= link_to user.name, user_path(user) %></p>
    </div>
  <% end %>
<% else %>
  <p>該当するユーザーが見つかりませんでした。</p>
<% end %>