<%# 会員情報編集ページ %>
<div class="user-form-container">
  <h1>会員情報編集</h1>

  <%# 入力エラーがある場合にメッセージを表示 %>
  <% if @user.errors.any? %>
    <div class="error-messages">
      <ul>
        <% @user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# 会員情報編集フォーム %>
  <%= form_with model: @user do |f| %>

    <%# 氏名 %>
    <div>
      <%= f.label :name, "氏名" %>
      <%= f.text_field :name %>
    </div>

    <%# メールアドレス %>
    <div>
      <%= f.label :email_address, "メールアドレス" %>
      <%= f.email_field :email_address %>
    </div>

    <%# パスワード %>
    <div>
      <%= f.label :password, "パスワード" %>
      <%= f.password_field :password %>
    </div>

    <%# パスワード確認 %>
    <div>
      <%= f.label :password_confirmation, "パスワード確認" %>
      <%= f.password_field :password_confirmation %>
    </div>

        <%# 更新ボタン %>
    <div>
      <%= f.submit "更新する" %>
    </div>

  <% end %>

  <%# 退会ボタン %>
  <div>
    <%= button_to "退会する",
                  user_path(@user),
                  method: :delete,
                  data: { turbo_confirm: "本当に退会しますか？" } %>
  </div>
</div>