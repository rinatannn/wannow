<h1>愛犬プロフィール登録</h1>

<%= form_with model: @dog do |f| %>
  <div>
    <%= f.label :name, "愛犬の名前" %>
    <%= f.text_field :name %>
  </div>

  <div>
    <%= f.label :breed, "犬種" %>
    <%= f.text_field :breed %>
  </div>

  <div>
    <%= f.label :personality, "性格" %>
    <%= f.text_area :personality %>
  </div>

  <div>
    <%= f.submit "登録する" %>
  </div>
<% end %>