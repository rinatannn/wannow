<h1>投稿詳細</h1>

<h2><%= @post.title %></h2>

<p><%= @post.body %></p>

<p>投稿者：<%= @post.user.name %></p>

<p>投稿日：<%= @post.created_at.strftime("%Y/%m/%d") %>（<%= %w(日 月 火 水 木 金 土)[@post.created_at.wday] %>）</p>

<hr>

<% if authenticated? && Current.user == @post.user %>
  <p><%= link_to "編集する", edit_post_path(@post) %></p>

  <p>
    <%= button_to "削除する", post_path(@post),
        method: :delete,
        data: { turbo_confirm: "本当に削除しますか？" } %>
  </p>
<% end %>

<%= link_to "投稿一覧に戻る", posts_path %>