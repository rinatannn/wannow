<h1>投稿一覧</h1>

<%= link_to "新規投稿", new_post_path, class: "post-new-button" %>

<%= form_with url: posts_path, method: :get, local: true do |f| %>
  <%= f.text_field :keyword, value: params[:keyword], placeholder: "キーワードを入力" %>
  <%= f.submit "検索" %>
<% end %>

<% if @posts.any? %>
  <% @posts.each do |post| %>
    <div>
      <h2><%= link_to post.title, post_path(post) %></h2>

      <p><%= post.body %></p>

      <p>投稿者：<%= post.user.name %></p>

      <p>投稿日：<%= post.created_at.strftime("%Y/%m/%d") %>（<%= %w(日 月 火 水 木 金 土)[post.created_at.wday] %>）</p>
      <p>♡ <%= post.likes.count %> 件</p>

      <% if authenticated? && !Current.user.guest? %>
        <% if Current.user.likes.exists?(post_id: post.id) %>
          <%= button_to "♥ いいね解除", post_like_path(post), method: :delete %>
        <% else %>
          <%= button_to "♡ いいね", post_like_path(post), method: :post %>
        <% end %>
      <% end %>

      <hr>
    </div>
  <% end %>
<% else %>
  <% if params[:keyword].present? %>
    <p>検索条件に一致する投稿がありません。</p>
  <% else %>
    <p>まだ投稿がありません。</p>
  <% end %>
<% end %>