<h1>新規投稿</h1>

<%= form_with model: @post do |f| %>
  <% if @post.errors.any? %>
    <div>
      <h2>入力内容を確認してください</h2>
      <ul>
        <% @post.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :title, "タイトル" %>
    <%= f.text_field :title %>
  </div>

  <div>
    <%= f.label :body, "本文" %>
    <%= f.text_area :body %>
  </div>

  <div>
    <%= f.submit "投稿する" %>
  </div>
<% end %>

<p><%= link_to "投稿一覧に戻る", posts_path %></p>