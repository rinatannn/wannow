<div class="container group-show">

  <div class="group-show-card">

    <h1><%= @group.name %></h1>
    <p class="group-show-description"><%= @group.description %></p>

    <hr>

    <div class="group-show-membership">

      <% if authenticated? %>

        <% if @group.user_id == Current.user.id %>

          <p class="group-show-message">
            🐾 あなたが作成したグループです。
          </p>

        <% else %>

          <% membership = Current.user.group_memberships.find_by(group: @group) %>

          <% if membership&.approved? %>

            <p class="group-show-message">
              このグループに参加しています。
            </p>

            <%= button_to "グループから退会する",
                          group_group_membership_path(@group),
                          method: :delete,
                          class: "group-show-leave-button" %>

          <% elsif membership&.pending? %>

            <p class="group-show-pending">
              🕒 参加申請中（承認待ち）
            </p>

          <% else %>

            <p class="group-show-message">
              このグループに参加してみませんか？
            </p>

            <%= button_to "参加申請する",
                          group_group_membership_path(@group),
                          method: :post,
                          class: "group-show-join-button" %>

          <% end %>

        <% end %>

      <% else %>

        <p class="group-show-message">
          グループに参加するにはログインが必要です。
        </p>

        <%= link_to "ログインする",
                    new_session_path,
                    class: "group-show-login-button" %>

      <% end %>

    </div>

  </div>

  <% if @pending_memberships %>

    <div class="group-show-requests">

      <h2>参加申請一覧</h2>

      <% if @pending_memberships.any? %>

        <% @pending_memberships.each do |membership| %>

          <div class="group-show-request-card">

            <p>申請者：<%= membership.user.name %></p>

            <div class="group-show-request-actions">

              <%= button_to "承認",
                            approve_group_group_membership_path(@group, membership),
                            method: :patch,
                            class: "group-show-approve-button" %>

              <%= button_to "拒否",
                            reject_group_group_membership_path(@group, membership),
                            method: :patch,
                            class: "group-show-reject-button" %>

            </div>

          </div>

        <% end %>

      <% else %>

        <p>現在、承認待ちの申請はありません。</p>

      <% end %>

    </div>

  <% end %>

  <div class="group-show-back">
    <%= link_to "← グループ一覧に戻る", groups_path %>
  </div>

</div>