<%# マイページ %>
<div class="user-page-container">
  <h1>マイページ</h1>

  <p>
    <strong>氏名：</strong>
    <%= @user.name %>
  </p>

  <p>
    <strong>メールアドレス：</strong>
    <%= @user.email_address %>
  </p>

  <%= link_to "会員情報を編集する", edit_user_path(@user), class: "mypage-edit-button" %>

  <%= button_to "退会する", user_path(@user),
              method: :delete,
              class: "mypage-withdraw-button",
              data: { turbo_confirm: "本当に退会しますか？" } %>

    <hr>

  <h2>🐾 愛犬情報</h2>

  <% if @user.dogs.any? %>
    <% @user.dogs.each do |dog| %>
      <div class="dog-profile-card">
  <div class="mypage-dog-content">

    <div class="mypage-dog-info">
      <p><strong>名前：</strong><%= dog.name %></p>
      <p><strong>犬種：</strong><%= dog.breed %></p>
      <p><strong>性格：</strong><%= dog.personality %></p>
      <%= link_to "愛犬の詳細を見る", dog_path(dog) %>
    </div>

    <div class="mypage-dog-photo">
      <% if dog.photo.attached? %>
        <%= image_tag dog.photo, alt: "#{dog.name}の写真" %>
      <% else %>
        <p>写真未登録</p>
      <% end %>
    </div>

  </div>
</div>
      <hr>
    <% end %>
  <% else %>
    <p>愛犬情報はまだ登録されていません。</p>
  <% end %>

    <hr>

  <h2>📝 自分の投稿一覧</h2>

  <% if @user.posts.any? %>
    <% @user.posts.order(created_at: :desc).each do |post| %>
      <div class="mypage-post-card">
  <h3 class="mypage-post-title">
    <%= link_to post.title, post_path(post) %>
  </h3>

  <p class="mypage-post-body"><%= post.body %></p>

  <p class="mypage-post-date">
    投稿日：<%= post.created_at.strftime("%Y/%m/%d") %>
  </p>
  <%= link_to "投稿の詳細を見る →", post_path(post), class: "mypage-post-link" %>
</div>
    <% end %>
  <% else %>
    <p>まだ投稿がありません。</p>
  <% end %>
</div>